# config/.env
# Variables de entorno para el proyecto

# SECRET KEY (generar una nueva para producción)
SECRET_KEY=django-insecure-clave-segura-unica-para-tu-proyecto

# DEBUG MODE
DEBUG=True

# BASE DE DATOS - MARIADB
DB_NAME=identia_db
DB_USER=root
DB_PASSWORD=''
DB_HOST=localhost
DB_PORT=3306

# CONFIGURACIÓN DE LOGIN
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_TIMEOUT=300  # 5 minutos en segundos

# OPENCV Y RECONOCIMIENTO FACIAL
FACE_RECOGNITION_THRESHOLD=0.6
FACE_RECOGNITION_MODEL=hog  

# EMAIL (para futuras notificaciones)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False